<?xml version='1.0' encoding='utf-8' ?>
<!-- Demo workbook for TWB Inspector. Invented data model, no real data. -->
<workbook source-build='2024.2.0 (demo)' version='18.1'>
  <datasources>
    <datasource hasconnection='false' inline='true' name='Parameters' version='18.1'>
      <column caption='Top N' datatype='integer' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='10'>
        <calculation class='tableau' formula='10' />
        <range granularity='1' max='25' min='3' />
      </column>
      <column caption='Currency' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
        <calculation class='tableau' formula='&quot;EUR&quot;' />
        <members><member value='&quot;EUR&quot;' /><member value='&quot;USD&quot;' /></members>
      </column>
    </datasource>
    <datasource caption='Coffee Shop (DWH)' inline='true' name='federated.coffee' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='acme.snowflakecomputing.com' name='snowflake.dwh'>
            <connection class='snowflake' dbname='SALES' schema='MART' server='acme.snowflakecomputing.com' warehouse='BI_WH' />
          </named-connection>
        </named-connections>
        <metadata-records>
          <metadata-record class='column'><remote-name>ORDER_ID</remote-name><local-name>[Order ID]</local-name><parent-name>[Sales]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>ORDER_DATE</remote-name><local-name>[Order Date]</local-name><parent-name>[Sales]</parent-name><local-type>date</local-type></metadata-record>
          <metadata-record class='column'><remote-name>STORE_ID</remote-name><local-name>[Store ID]</local-name><parent-name>[Sales]</parent-name><local-type>integer</local-type></metadata-record>
          <metadata-record class='column'><remote-name>PRODUCT_ID</remote-name><local-name>[Product ID]</local-name><parent-name>[Sales]</parent-name><local-type>integer</local-type></metadata-record>
          <metadata-record class='column'><remote-name>QUANTITY</remote-name><local-name>[Quantity]</local-name><parent-name>[Sales]</parent-name><local-type>integer</local-type></metadata-record>
          <metadata-record class='column'><remote-name>UNIT_PRICE</remote-name><local-name>[Unit Price]</local-name><parent-name>[Sales]</parent-name><local-type>real</local-type></metadata-record>
          <metadata-record class='column'><remote-name>UNIT_COST</remote-name><local-name>[Unit Cost]</local-name><parent-name>[Sales]</parent-name><local-type>real</local-type></metadata-record>
          <metadata-record class='column'><remote-name>DISCOUNT</remote-name><local-name>[Discount]</local-name><parent-name>[Sales]</parent-name><local-type>real</local-type></metadata-record>
          <metadata-record class='column'><remote-name>STORE_ID</remote-name><local-name>[Store ID (Stores)]</local-name><parent-name>[Stores]</parent-name><local-type>integer</local-type></metadata-record>
          <metadata-record class='column'><remote-name>REGION</remote-name><local-name>[Region]</local-name><parent-name>[Stores]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>CITY</remote-name><local-name>[City]</local-name><parent-name>[Stores]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>MANAGER</remote-name><local-name>[Manager]</local-name><parent-name>[Stores]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>PRODUCT_ID</remote-name><local-name>[Product ID (Products)]</local-name><parent-name>[Products]</parent-name><local-type>integer</local-type></metadata-record>
          <metadata-record class='column'><remote-name>PRODUCT_NAME</remote-name><local-name>[Product Name]</local-name><parent-name>[Products]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>CATEGORY</remote-name><local-name>[Category]</local-name><parent-name>[Products]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>REGION</remote-name><local-name>[Region (Targets)]</local-name><parent-name>[Targets]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>TARGET</remote-name><local-name>[Target]</local-name><parent-name>[Targets]</parent-name><local-type>real</local-type></metadata-record>
        </metadata-records>
      </connection>
      <column caption='Revenue' datatype='real' name='[Calculation_101]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Quantity] * [Unit Price] * (1 - [Discount])' />
      </column>
      <column caption='Profit' datatype='real' name='[Calculation_102]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_101] - [Quantity] * [Unit Cost]' />
      </column>
      <column caption='Profit Margin' datatype='real' name='[Calculation_103]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_102]) / SUM([Calculation_101])' />
      </column>
      <column caption='Revenue vs Target' datatype='real' name='[Calculation_104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_101]) / SUM([Target])' />
      </column>
      <column caption='Region Revenue' datatype='real' name='[Calculation_105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Region] : SUM([Calculation_101]) }' />
      </column>
      <column caption='Revenue Rank' datatype='integer' name='[Calculation_106]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([Calculation_101]))' />
      </column>
      <column caption='Is Top N Product' datatype='boolean' name='[Calculation_107]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_106] &lt;= [Parameters].[Parameter 1]' />
      </column>
      <column caption='Margin (old)' datatype='real' name='[Calculation_108]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// copied from an older version&#10;sum([Calculation_102]) /   sum([Calculation_101])' />
      </column>
      <column caption='Store Label' datatype='string' name='[Calculation_109]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='UPPER(LEFT([City], 3)) + &quot;-&quot; + STR([Store ID]) + &quot; &quot; + TRIM(REPLACE([Manager], &quot;.&quot;, &quot;&quot;)) + &quot; (&quot; + LOWER([Region]) + &quot;)&quot;' />
      </column>
      <column caption='Unique Customers' datatype='integer' name='[Calculation_110]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Order ID])' />
      </column>
      <extract count='-1' enabled='true' units='records'>
        <connection class='hyper' dbname='Data/Extracts/coffee.hyper'>
          <relation name='Extract' table='[Extract].[Extract]' type='table' />
        </connection>
      </extract>
      <object-graph>
        <objects>
          <object caption='Sales' id='Sales_1'>
            <properties context=''>
              <relation join='inner' type='join'>
                <clause type='join'>
                  <expression op='='>
                    <expression op='[Sales].[STORE_ID]' />
                    <expression op='[Stores].[STORE_ID]' />
                  </expression>
                </clause>
                <relation connection='snowflake.dwh' name='Sales' table='[MART].[FACT_SALES]' type='table' />
                <relation connection='snowflake.dwh' name='Stores' table='[MART].[DIM_STORE]' type='table' />
              </relation>
            </properties>
          </object>
          <object caption='Products' id='Products_2'>
            <properties context=''>
              <relation connection='snowflake.dwh' name='Products' table='[MART].[DIM_PRODUCT]' type='table' />
            </properties>
          </object>
          <object caption='Targets' id='Targets_3'>
            <properties context=''>
              <relation connection='snowflake.dwh' name='Targets' type='text'>SELECT region, SUM(target_eur) AS target
FROM finance.sales_targets
WHERE fiscal_year = 2026
GROUP BY region</relation>
            </properties>
          </object>
        </objects>
        <relationships>
          <relationship>
            <expression op='='><expression op='[Product ID]' /><expression op='[Product ID (Products)]' /></expression>
            <first-end-point object-id='Sales_1' /><second-end-point object-id='Products_2' />
          </relationship>
          <relationship>
            <expression op='='><expression op='[Region]' /><expression op='[Region (Targets)]' /></expression>
            <first-end-point object-id='Sales_1' /><second-end-point object-id='Targets_3' />
          </relationship>
        </relationships>
      </object-graph>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='KPIs'>
      <table><view>
        <datasource-dependencies datasource='federated.coffee'>
          <column-instance column='[Calculation_101]' derivation='Sum' name='[sum:Calculation_101:qk]' pivot='key' type='quantitative' />
          <column-instance column='[Calculation_103]' derivation='User' name='[usr:Calculation_103:qk]' pivot='key' type='quantitative' />
          <column-instance column='[Calculation_110]' derivation='User' name='[usr:Calculation_110:qk]' pivot='key' type='quantitative' />
        </datasource-dependencies>
      </view></table>
    </worksheet>
    <worksheet name='Revenue Trend'>
      <table><view>
        <datasource-dependencies datasource='federated.coffee'>
          <column-instance column='[Order Date]' derivation='Month' name='[mn:Order Date:ok]' pivot='key' type='ordinal' />
          <column-instance column='[Calculation_101]' derivation='Sum' name='[sum:Calculation_101:qk]' pivot='key' type='quantitative' />
          <column-instance column='[Category]' derivation='None' name='[none:Category:nk]' pivot='key' type='nominal' />
        </datasource-dependencies>
      </view></table>
    </worksheet>
    <worksheet name='Top Products'>
      <table><view>
        <datasource-dependencies datasource='federated.coffee'>
          <column-instance column='[Product Name]' derivation='None' name='[none:Product Name:nk]' pivot='key' type='nominal' />
          <column-instance column='[Calculation_101]' derivation='Sum' name='[sum:Calculation_101:qk]' pivot='key' type='quantitative' />
          <column-instance column='[Calculation_107]' derivation='User' name='[usr:Calculation_107:nk]' pivot='key' type='nominal' />
        </datasource-dependencies>
        <filter class='categorical' column='[federated.coffee].[usr:Calculation_107:nk]' />
      </view></table>
    </worksheet>
    <worksheet name='Targets by Region'>
      <table><view>
        <datasource-dependencies datasource='federated.coffee'>
          <column-instance column='[Region]' derivation='None' name='[none:Region:nk]' pivot='key' type='nominal' />
          <column-instance column='[Calculation_104]' derivation='User' name='[usr:Calculation_104:qk]' pivot='key' type='quantitative' />
          <column-instance column='[Calculation_105]' derivation='User' name='[usr:Calculation_105:qk]' pivot='key' type='quantitative' />
        </datasource-dependencies>
      </view></table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name='Sales Overview'>
      <zones>
        <zone id='1' type-v2='layout-basic'>
          <zone id='2' name='KPIs' />
          <zone id='3' name='Revenue Trend' />
          <zone id='4' name='Top Products' />
          <zone id='5' param='[Parameters].[Parameter 1]' type-v2='paramctrl' />
        </zone>
      </zones>
    </dashboard>
  </dashboards>
</workbook>
